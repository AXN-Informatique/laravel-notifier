{
    "name" : "axn/laravel-notifier",
    "description" : "Alerts/notifications for Laravel",
    "homepage" : "https://github.com/AXN-Informatique/laravel-notifier",
    "support" : {
        "issues" : "https://github.com/AXN-Informatique/laravel-notifier/issues"
    },
    "type": "library",
    "license" : "MIT",
    "authors" : [{
            "name" : "AXN Informatique",
            "email" : "developpement@axn.fr"
        }
    ],
    "require" : {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "laravel/pint": "^1.31.1",
        "orchestra/testbench": "^11.2.0",
        "pestphp/pest": "^5.1.4",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpunit/phpunit": "^13.3.2",
        "rector/rector": "^2.6.6"
    },
    "autoload": {
        "psr-4": {
            "Axn\\Notifier\\" : "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Axn\\Notifier\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers" : [
                "Axn\\Notifier\\ServiceProvider"
            ]
        }
    },
    "config" : {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability" : "dev",
    "prefer-stable": true
}
